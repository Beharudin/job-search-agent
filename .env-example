# Claude Agent SDK auth — console.anthropic.com
ANTHROPIC_API_KEY=

# Adzuna — developer.adzuna.com (free app id + key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Gmail — needs a 16-character App Password (requires 2-Step Verification), not your normal password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional — defaults to GMAIL_USER
TO_EMAIL=

# Optional — comma-separated; defaults to the list below
SEARCH_KEYWORDS=react developer,next.js developer,full stack developer,software engineer


# Country	Code / Acronym	Domain Example
# 🇦🇺 Australia	AU	adzuna.com.au
# 🇦🇹 Austria	AT	adzuna.at
# 🇧🇪 Belgium	BE	adzuna.be
# 🇧🇷 Brazil	BR	adzuna.com.br
# 🇨🇦 Canada	CA	adzuna.ca
# 🇨🇭 Switzerland	CH	adzuna.ch
# 🇩🇪 Germany	DE	adzuna.de
# 🇪🇸 Spain	ES	adzuna.es
# 🇫🇷 France	FR	adzuna.fr
# 🇬🇧 United Kingdom	UK (or GB via API)	adzuna.co.uk
# 🇮🇳 India	IN	adzuna.in
# 🇮🇹 Italy	IT	adzuna.it
# 🇲🇽 Mexico	MX	adzuna.mx
# 🇳🇱 Netherlands	NL	adzuna.nl
# 🇳🇿 New Zealand	NZ	adzuna.co.nz
# 🇵🇱 Poland	PL	adzuna.pl
# 🇷🇺 Russia	RU	adzuna.ru
# 🇸🇬 Singapore	SG	adzuna.sg
# 🇺🇸 United States	US	adzuna.com
# 🇿🇦 South Africa	ZA	adzuna.co.za